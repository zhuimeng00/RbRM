#630 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#627,
  'distance_accuracy_value','confusion accuracy');
#631 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
